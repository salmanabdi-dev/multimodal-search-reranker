# Copy to .env (make up does this automatically). All settings use the MMS_ prefix.
MMS_DEVICE=cpu
MMS_TORCH_THREADS=4

MMS_BI_ENCODER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MMS_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Stage 1
MMS_CANDIDATE_CHUNKS=50
MMS_EF_SEARCH=100
# Stage 2
MMS_RERANK_CANDIDATES=25
MMS_RERANK_MAX_LENGTH=256
MMS_RERANK_QUANTIZE=false

# Images (CLIP)
MMS_ENABLE_IMAGES=true
MMS_CLIP_MODEL=openai/clip-vit-base-patch32
MMS_IMAGE_CANDIDATES=20
MMS_CAPTION_WEIGHT=0.5
# CLIP score calibration; fit yours with `make calibrate-images`
MMS_CLIP_CALIB_A=40.0
MMS_CLIP_CALIB_B=-10.0

MMS_LOG_LEVEL=INFO
